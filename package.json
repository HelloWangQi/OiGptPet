{
  "name": "oigptpet",
  "version": "0.1.0",
  "private": true,
  "description": "A VRM anime desktop companion with ChatGPT sprite export",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "demo:fetch": "node scripts/fetch-demo.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^45.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
