{
  "name": "oigptpet",
  "version": "0.9.6",
  "private": true,
  "description": "A VRM anime desktop companion with ChatGPT sprite export",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode test-demo",
    "start": "electron .",
    "test": "vitest run --exclude \"**/.cache/**\"",
    "test:smoke": "node scripts/smoke.mjs",
    "test:phase-three": "node scripts/phase-three-smoke.mjs",
    "test:phase-four": "npm run build:demo && node scripts/phase-four-smoke.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "verify:desktop": "npm run package && npm run test:release",
    "test:soak": "node scripts/desktop-soak.mjs",
    "test:chat-stress": "node scripts/chat-stress.mjs",
    "test:chat-mixed": "node scripts/chat-stress.mjs --mixed",
    "test:chat-memory": "node scripts/chat-stress.mjs --mixed --fixed-windows --cycles 8 --settle-seconds 5",
    "test:chat-soak": "node scripts/chat-stress.mjs --minutes 60",
    "test:chat-soak-default": "node scripts/chat-stress.mjs --minutes 60 --renderer default",
    "demo:fetch": "node scripts/fetch-demo.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^45.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
